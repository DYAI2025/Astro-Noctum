# EAS Build — exclude everything the mobile app doesn't need
# Goal: reduce from 676MB to <100MB

# Large non-mobile directories
.worktrees/
features/
media/
public/
dist/
landing/
bazodiac_engine/
docs/

# Web app source (not needed for mobile build)
src/
server.mjs

# Build artifacts and caches
coverage/
.expo/
*.log
.DS_Store

# Git
.git/
