# Gemini API key for horoscope text generation (server-side only — do NOT prefix with VITE_).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# BAFE API base URL for astrology calculations.
VITE_BAFE_BASE_URL="https://bafe.vercel.app"

# ── Supabase (Frontend — VITE_ prefix exposed to browser) ────────────
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ── Supabase (Server-only — NOT exposed to browser) ──────────────────
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Google Places API key (optional – enables city autocomplete in BirthForm)
VITE_GOOGLE_PLACES_API_KEY=""

# ElevenLabs voice widget agent id (Levi Bazi)
VITE_ELEVENLABS_AGENT_ID="YOUR_ELEVENLABS_AGENT_ID"

# ElevenLabs voice widget agent id (Eve)
VITE_ELEVENLABS_EVE_AGENT_ID=""

# ElevenLabs tool secret (server-side, protects /api/profile/:userId)
ELEVENLABS_TOOL_SECRET="YOUR_ELEVENLABS_TOOL_SECRET"

# ── Stripe (Server-only) ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=https://bazodiac.com

# ── FuFirE / Transit & Experience API (Server-only) ─────────────────
# Base URL for the FuFirE backend — used by server.mjs for:
#   /api/transit-state  → FuFirE /transit/state
#   /api/experience/*   → FuFirE /experience/{bootstrap,signature-delta,daily}
# In production this is the same host as BAFE (internal Railway URL preferred).
# Falls back to BAFE_INTERNAL_URL → VITE_BAFE_BASE_URL if not set.
FUFIRE_BASE_URL=""
# Railway-internal BAFE/FuFirE URL (bypasses public internet; faster, no egress cost)
BAFE_INTERNAL_URL=""

# ── Space Weather (NOAA SWPC + NASA DONKI) ─────────────────────────
# NOAA SWPC base URL (no API key required, highly reliable)
NOAA_SWPC_BASE_URL=https://services.swpc.noaa.gov
# NASA API key: Get free key at https://api.nasa.gov (DEMO_KEY used if missing, 30 req/hr)
NASA_API_KEY=""

# ── Sprint 07: sky.bazodiac.space Phase 2+3 ─────────────────────────
# GFZ Potsdam Kp index (used by Aurora Layer for Europe Kp nowcast)
GFZ_KP_BASE_URL=https://www-app3.gfz-potsdam.de/kp_index/
# SIDC/SILSO sunspot data (used by Epoch Mood Layer)
# NOTE: Currently unused/reserved for future features; safe to leave unset.
SIDC_SILSO_BASE_URL=https://www.sidc.be/silso/
# JPL Horizons API (used by Geometry Verify proxy, server-only, 1h cache)
JPL_HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
