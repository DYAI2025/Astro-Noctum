{
  "version": "0.1.0",
  "product": "Bazodiac",
  "summary": "FuFirE-Brücke: Planet/Zeichen/Haus/Aspekt -> Archetyp-Aktivierung",
  "principles": [
    "Planet = psychische Funktion / Energiequelle",
    "Zeichen = Stil oder Ausdruck der Energie",
    "Haus = Lebensbereich / Kontext",
    "Aspekt = Spannungs- oder Integrationsmodus",
    "Astrologie liefert Prior-Hypothesen, Quiz liefert Verhaltenskorrektur"
  ],
  "fusion_formula": {
    "final_archetype_score": "0.60 * astro_prior + 0.40 * quiz_evidence",
    "final_state_score": "state_from_quiz + aspect_modifiers + projection_signals",
    "mismatch_index": "abs(astro_prior - quiz_evidence)"
  },
