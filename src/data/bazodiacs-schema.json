{
  "version": "1.1.0",
  "product": "Bazodiac",
  "concept": {
    "definition": "Ein Bazodiac ist keine Figur, kein Archetyp, kein Charakter. Es ist ein FELD — ein multidimensionaler Raum, der aus der Fusion von westlicher und östlicher Astrologie entsteht und durch Quiz-Antworten bepflanzt wird.",
    "origin": "Bazi + Zodiac = Bazodiac. Das Wesen, das aus der Verschmelzung zweier Systeme entsteht, mit mehr Feinheit und Kontur als die Summe beider.",
    "signature": "Die Signatur ist das Bilderfeld — das gewachsene Muster aus astrologischem Prior und gelebter Tendenz.",
    "field_metaphor": "Jeder Mensch trägt alle 12 Bazodiacs als Felder mit unterschiedlicher Gewichtung. Quiz-Antworten sind Samen, die in diese Felder gepflanzt werden und Licht-, Balance- oder Schatten-Tendenzen wachsen lassen.",
    "naming_architecture": {
      "layer_1_engine": "Stabile IDs: ruler, warrior, lover etc. — Funktionsnamen für Logik, Matching, Code. Ändern sich nie.",
      "layer_2_label": "Deutsche Produkt-Labels: Souverän, Kämpfer etc. — Was der User im Profil sieht. Funktional, aber modern.",
      "layer_3_skins": "Wechselnde Bilder aus Quiz-Welten: Zeus, Thor, Drachenkönig etc. — Sammelbar, teilbar, erinnerbar. Inkl. Systems-Poetry-Set (The Architect, Cloud Walker, Thunder Voice)."
    }
  },
